{
  "name": "asmr-db",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,server -c blue,green \"npm run dev:web\" \"npm run dev:server\"",
    "dev:web": "vite",
    "dev:server": "cargo run --manifest-path server/Cargo.toml",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "npm run build && cargo run --release --manifest-path server/Cargo.toml"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "lucide-vue-next": "^0.475.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/howler": "^2.2.13",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vue-tsc": "^2.2.0"
  }
}
